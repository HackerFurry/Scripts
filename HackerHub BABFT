-- Точки фарма (проверяем их существование)
local function getCaveParts()
    local stage1 = workspace:FindFirstChild("BoatStages") and workspace.BoatStages:FindFirstChild("NormalStages") and workspace.BoatStages.NormalStages:FindFirstChild("CaveStage1")
    local stage10 = workspace:FindFirstChild("BoatStages") and workspace.BoatStages:FindFirstChild("NormalStages") and workspace.BoatStages.NormalStages:FindFirstChild("CaveStage10")
    local part1 = stage1 and stage1:FindFirstChild("DarknessPart")
    local part10 = stage10 and stage10:FindFirstChild("DarknessPart")
    return part1, part10
end

