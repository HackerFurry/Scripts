-- ========== ФУНКЦИЯ СОЗДАНИЯ ESP ==========
local function createESP(adornee, text, color, folderName)
    if not adornee or not adornee.Parent then return nil end

    local oldFolder = adornee:FindFirstChild(folderName)
    if oldFolder then oldFolder:Destroy() end

    local folder = Instance.new("Folder")
    folder.Name = folderName
    folder.Parent = adornee

    local highlight = Instance.new("Highlight")
    highlight.Name = "Highlight"
    highlight.FillColor = color or Color3.fromRGB(255, 0, 0)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Parent = folder
    highlight.Adornee = adornee

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "Billboard"
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = folder
    billboard.Adornee = adornee

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0
    label.Text = text or "ESP"
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.Parent = billboard

    return folder
end

local function destroyESP(folderName)
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj.Name == folderName then
            obj:Destroy()
        end
    end
end

local function updateESP()
    if espEnabled then
        -- Подсвечиваем всех игроков (кроме себя)
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                if not espObjects[player] then
                    local folder = createESP(char, player.Name, espColor, "PlayerESP_Folder")
                    if folder then espObjects[player] = folder end
                else
                    -- Обновляем цвет, если изменился
                    local highlight = espObjects[player]:FindFirstChild("Highlight")
                    if highlight then highlight.FillColor = espColor end
                end
            end
        end
    else
        -- Удаляем все ESP
        destroyESP("PlayerESP_Folder")
        espObjects = {}
    end
end

-- ========== ФАРМ ==========
local function startFarm()
    if farmRunning then return end
    local part1, part10 = getCaveParts()
    if not part1 or not part10 then
        Fluent:Notify({
            Title = "Ошибка",
            Content = "Не найдены точки CaveStage1 или CaveStage10!",
            Duration = 3
        })
        return
    end

    farmRunning = true
    farmTask = coroutine.wrap(function()
        while farmRunning do
            -- Летим к первой точке
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = part1.CFrame + Vector3.new(0, 3, 0)
            end
            task.wait(farmSpeed)
            if not farmRunning then break end

            -- Летим ко второй точке
            hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = part10.CFrame + Vector3.new(0, 3, 0)
            end
            task.wait(farmSpeed)
        end
    end)
    farmTask()
    Fluent:Notify({
        Title = "Farm",
        Content = "Фарм запущен!",
        Duration = 2
    })
end

local function stopFarm()
    farmRunning = false
    farmTask = nil
    Fluent:Notify({
        Title = "Farm",
        Content = "Фарм остановлен.",
        Duration = 2
    })
end

-- ========== ОБНОВЛЕНИЕ ЗОЛОТА ==========
local function updateGoldList()
    local goldDisplay = {}
    for _, player in pairs(Players:GetPlayers()) do
        local gold = player:FindFirstChild("Data") and player.Data:FindFirstChild("Gold")
        local amount = gold and gold.Value or 0
        table.insert(goldDisplay, player.Name .. " - " .. amount .. " Gold")
    end
    return table.concat(goldDisplay, "\n")
end

local function refreshGoldDisplay()
    if goldList and goldList.TextLabel then
        goldList.TextLabel.Text = updateGoldList()
    end
end

